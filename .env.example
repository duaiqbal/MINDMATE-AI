# Copy to .env and fill in real values. NEVER commit .env.
# All values here are placeholders only.

# ---- Backend ----
APP_ENV=development
# Comma-separated browser origins allowed to call the API (non-secret)
CORS_ALLOW_ORIGINS=http://localhost:5173

# Supabase (server-side)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server only; never ship to the client
SUPABASE_JWT_SECRET=

# LLM gateway (resolved later; the gateway reads these)
LLM_MODEL_NAME=
LLM_TIMEOUT_SECONDS=

# ---- Frontend (Vite) ----
# Only VITE_* variables are exposed to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
