# Copy to .env and fill in real values. NEVER commit .env.
# All values here are placeholders only.

# ---- Backend ----
APP_ENV=development
# Comma-separated browser origins allowed to call the API (non-secret)
CORS_ALLOW_ORIGINS=http://localhost:5173

# Supabase (server-side)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server only; never ship to the client
SUPABASE_JWT_SECRET=

# LLM gateway (OpenRouter). Put the real key ONLY in mindmate/backend/.env.
# Without a key the chat answers with a safe template.
OPENROUTER_API_KEY=
LLM_MODEL_NAME=google/gemma-4-31b-it:free
# Tried in order when the primary model is busy (comma-separated)
LLM_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,baidu/ernie-5.5-flash-preview:free
LLM_TIMEOUT_SECONDS=30

# ---- Frontend (Vite) ----
# Only VITE_* variables are exposed to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
